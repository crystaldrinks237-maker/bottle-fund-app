# Get this from your Neon project dashboard (Connection string, pooled)
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Any random long string - used to sign login sessions
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Set this to your own username after your first signup to become the first admin
FIRST_ADMIN_USERNAME=
