# --- required ---
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- optional ---
# Timezone used to DISPLAY times and bucket months (database always stores UTC). Default Asia/Karachi.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
# The guarantor of everyone who joins WITHOUT a referral link (normally your admin username). Optional but recommended.
DEFAULT_GUARANTOR_USERNAME=admin
# Set to "false" to close public investor sign-up.
ALLOW_SIGNUP=true

# Google sign-in (optional; the button only appears when both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- one-off scripts only (npm run db:bootstrap-admin); NOT needed at runtime ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-password

# --- public website contact form ---
# The form always saves messages to Admin → Website Messages. To ALSO get them by email (the address is never shown on the site), set CONTACT_TO_EMAIL plus ONE of:
#   (a) Resend (simplest): RESEND_API_KEY from resend.com — free tier; sends from onboarding@resend.dev to your own signup email
#   (b) Gmail SMTP: SMTP_USER=your gmail + SMTP_PASS=a Google "App password" (Google Account → Security → 2-Step Verification → App passwords)
# CONTACT_TO_EMAIL=
# RESEND_API_KEY=
# SMTP_USER=
# SMTP_PASS=
# Set NEXTAUTH_URL to https://www.crystaldrinks.pk in production; add https://www.crystaldrinks.pk/api/auth/callback/google as the Google redirect URI.
