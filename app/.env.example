# --- required ---
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- optional ---
# Timezone used to DISPLAY times and bucket months (database always stores UTC). Default Asia/Karachi.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
# Set to "false" to close public investor sign-up.
ALLOW_SIGNUP=true

# --- one-off scripts only (npm run db:bootstrap-admin); NOT needed at runtime ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-password
